{
  "name": "@versu/plugin-gradle",
  "version": "2.0.5",
  "description": "Versu Gradle Plugin",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/generate-version.js",
    "build": "tsc --project tsconfig.json --outDir dist && npm run copy-assets",
    "test": "vitest --passWithNoTests",
    "test:coverage": "vitest --coverage --passWithNoTests",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write src/**/*.ts",
    "copy-assets": "shx cp src/init-project-information.gradle.kts dist/"
  },
  "keywords": [
    "versu",
    "plugin",
    "gradle",
    "semantic-versioning",
    "conventional-commits",
    "version-engine",
    "dependency-cascade",
    "monorepo"
  ],
  "author": "tvcsantos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versuhq/plugin-gradle.git"
  },
  "bugs": {
    "url": "https://github.com/versuhq/plugin-gradle/issues"
  },
  "homepage": "https://github.com/versuhq/plugin-gradle#readme",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "dependencies": {
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3"
  },
  "peerDependencies": {
    "@versu/core": "^3.2.0"
  },
  "devDependencies": {
    "@versu/core": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.9",
    "shx": "^0.4.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
